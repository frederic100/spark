{
    "name": "logipro/spark",
    "type": "app",
    "description": "start a new PHP project with a simple base structure",
    "keywords": ["php", "DDT"],
    "homepage": "https://github.com/frederic100/spark",
    "license": "Copyrighted",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Frédéric Royet",
            "email": "frederic.royet@logipro.com",
            "homepage": "https://www.linkedin.com/in/frederic-royet-42568566/",
            "role": "Project Founder"
        }
    ],
    "require": {
        "php": "8.4.* || 8.5.*",
        "psr/log": "^3.0",
        "thecodingmachine/safe": "^3.3",
        "phariscope/safephp": "^1.0",
        "symfony/console": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/runtime": "^7.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/var-exporter": "^7.0",
        "phariscope/event-store": "^2.0",
        "phariscope/multitenant": "^0.0.14",
        "doctrine/orm": "^3.6",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0"
    },
    "require-dev": {
        "infection/extension-installer": "^0.1",
        "infection/infection": "*",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpdoc-parser": "2.*",
        "phpstan/phpstan": "2.*",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "4.* || 3.*",
        "behat/behat": "^3",
        "symfony/browser-kit": "^7.0"
    },
    "autoload": {
        "psr-4" : {
            "Spark\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4" : {
            "Tests\\Unit\\" : "tests/unit/",
            "Tests\\Features\\": "tests/features/",
            "Tests\\Integration\\": "tests/integration/",
            "Tests\\Support\\": "tests/Support/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "runtime": {
          "dotenv_path": "src/Infrastructure/Symfony/.env"
        }
      }
}
